# Keep the build context small. The venv alone is ~834MB and must never be
# copied into an image — the container installs its own dependencies.
venv
backend/venv
.venv
__pycache__
**/__pycache__
*.pyc

node_modules
frontend/node_modules
frontend/dist

.git

# Secrets are supplied at run time via env_file, never baked into a layer.
.env

.claude
.agents

# The Expo app. Self-contained and never part of any image — but its install
# directories are large, and the bare `node_modules` entry above does not match
# nested paths (which is why frontend/node_modules is listed separately).
mobile/node_modules
mobile/.expo
mobile/android
mobile/ios
mobile/dist
