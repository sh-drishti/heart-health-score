# Where the API lives. There is no nginx in front of a phone, so this must be
# an absolute URL — and the right value depends on where the app is running:
#
#   deployed backend      http://65.0.179.22
#   physical device       http://<your-machine's-LAN-IP>:8000   (NOT localhost)
#   Android emulator      http://10.0.2.2:8000
#   iOS simulator         http://localhost:8000
#
# The EXPO_PUBLIC_ prefix is what makes it readable at runtime; anything
# without it is stripped from the bundle.
EXPO_PUBLIC_API_URL=http://65.0.179.22
