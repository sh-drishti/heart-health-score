# Copy to .env.local for a non-default API location. Not needed for local dev:
# left unset, requests stay relative and the Vite proxy forwards /api to :8000.
#
# Set this for a deployed build, or when pointing at an API on another host.
# The origin must also be listed in the backend's CORS_ORIGINS.
# VITE_API_BASE=https://api.example.com
