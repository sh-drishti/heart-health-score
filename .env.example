# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=Cluster0
DATABASE_NAME=hhs_dashboard

# --- API authentication -----------------------------------------------------
# Signs access tokens. The API refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued access token.
JWT_SECRET=

# Access-token lifetime. Short on purpose: the client refreshes transparently,
# and a leaked token stops working quickly.
ACCESS_TOKEN_TTL_MIN=30

# How long a session survives without a login. Refresh tokens rotate on use.
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API, comma-separated. Native clients send
# no Origin header, so this only affects the web app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Email notifications ----------------------------------------------------
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Additional-parameter collection programme (temporary — see collection/).
# Shared code that gates the public /collect form. The endpoints refuse to
# serve when this is unset rather than defaulting to open. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
COLLECTION_ACCESS_CODE=
